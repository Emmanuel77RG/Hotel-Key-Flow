# ===================================================
# Hotel KeyFlow - Plantilla de Variables de Entorno
# Copia este archivo a .env y define tus credenciales reales
# ===================================================

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://admin:adminpsw_seguro@localhost:5432/hotel_keyflow

# Clave secreta para firma de tokens JWT (usar una cadena criptográfica de al menos 32 caracteres)
SECRET_KEY=reemplazar_con_una_llave_secreta_aleatoria_y_segura_para_produccion

# Algoritmo de cifrado JWT
ALGORITHM=HS256

# Tiempo de expiración del token JWT en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60
